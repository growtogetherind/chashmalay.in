rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Admin Guard ───────────────────────────────────────────────────────────
    // Reads the is_admin flag from the profile document.
    // IMPORTANT: Until Firebase Custom Claims are implemented via a Cloud Function,
    // this is the best client-side guard available. The profile write rule below
    // prevents users from setting is_admin on themselves.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }

    // ─── Products ──────────────────────────────────────────────────────────────
    // Public read. Only admins can create/delete/update.
    // Stock updates are now gated to admins only (previously any auth user could
    // change stock_quantity — attack vector for store shutdown).
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // ─── Profiles ──────────────────────────────────────────────────────────────
    // Users can read/write their own profile.
    // CRITICAL FIX: Users cannot write `is_admin` field (prevents self-promotion).
    match /profiles/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Allow users to create their own profile, ensuring is_admin is not set to true
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        (!('is_admin' in request.resource.data) || request.resource.data.is_admin == false);

      // Allow users to update their own profile but CANNOT modify is_admin
      allow update: if (request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.is_admin == resource.data.is_admin) || isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Cart Items ────────────────────────────────────────────────────────────
    match /cart_items/{itemId} {
      allow read, delete, update: if request.auth != null &&
        request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.user_id;
    }

    // ─── Orders ───────────────────────────────────────────────────────────────
    // CRITICAL FIX: Guest orders now require a positive total amount and
    // cannot be created with status 'delivered' or 'cancelled' (prevents fake orders).
    // Users can only read their own orders. Admins can read all.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.user_id);

      // Allow order creation for authenticated users
      allow create: if request.auth != null &&
        request.resource.data.total_amount > 0 &&
        request.resource.data.status == 'confirmed';

      // Allow guest order creation with restrictions
      allow create: if request.auth == null &&
        request.resource.data.total_amount > 0 &&
        request.resource.data.status == 'confirmed' &&
        request.resource.data.user_id.matches('guest-.*');

      // Users can only cancel their own confirmed orders
      allow update: if isAdmin() ||
        (request.auth != null &&
         request.auth.uid == resource.data.user_id &&
         request.resource.data.status == 'cancelled' &&
         resource.data.status == 'confirmed');
    }

    // ─── Order Items ──────────────────────────────────────────────────────────
    // CRITICAL FIX: Previously any authenticated user could read ALL order_items.
    // Now users can only read items belonging to their own orders.
    match /order_items/{itemId} {
      allow read: if isAdmin() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data.user_id
           == request.auth.uid);

      // Allow order_items creation for authenticated users creating a real order
      allow create: if request.auth != null;

      // Allow guest order_items (for guest checkout flow)
      allow create: if request.auth == null;

      // Admins can correct prescription/lens details from the order screen.
      allow update, delete: if isAdmin();
    }

    // ─── Coupons ──────────────────────────────────────────────────────────────
    // Admin only write. Public read is required for client-side coupon lookup.
    // TODO (server-side): Move coupon validation to a Cloud Function to prevent
    // client-side discount manipulation.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Reviews ──────────────────────────────────────────────────────────────
    // Publicly readable. Only logged-in, verified users can write their own review.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.user_id &&
        request.resource.data.status == 'pending' &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ─── Offers ───────────────────────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Carousel ─────────────────────────────────────────────────────────────
    match /carousel/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Brands ───────────────────────────────────────────────────────────────
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Categories ───────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Lens System (Categories, Lenses, Addons) ─────────────────────────────
    match /lens_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /lenses/{lensId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /lens_addons/{addonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Settings ─────────────────────────────────────────────────────────────
    // Firestore rules are ADDITIVE: if ANY matching rule grants access, it is
    // allowed. A public-read wildcard (`/settings/{id}`) would therefore also
    // expose a secrets document. So each settings doc is enumerated explicitly.
    //
    // Public storefront config (store name, contact, socials, shipping, carousel
    // interval, maintenance flag). Contains NO secrets — safe for anonymous read.
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sensitive integration secrets (Telegram bot token/chat id, Fast2SMS key).
    // Admin-only read AND write. These must never reach the public bundle or an
    // anonymous Firestore read; runtime message delivery uses server env vars.
    match /settings/private {
      allow read, write: if isAdmin();
    }

    match /prescriptions/{prescriptionId} {
      allow read: if isAdmin() || (request.auth != null && (request.auth.uid == resource.data.user_id || request.auth.uid == resource.data.guestId));
      
      allow create: if request.auth != null
        && (
          (request.resource.data.guestId == request.auth.uid && request.resource.data.guestId.matches('guest-.*'))
          ||
          (request.resource.data.user_id == request.auth.uid && !request.resource.data.user_id.matches('guest-.*'))
        )
        && !('verified' in request.resource.data)
        && !('verified_at' in request.resource.data)
        && !('orderId' in request.resource.data)
        && !('order_id' in request.resource.data);

      allow update: if isAdmin() || (
        request.auth != null &&
        (request.auth.uid == resource.data.user_id || request.auth.uid == resource.data.guestId) &&
        request.resource.data.order_id == resource.data.order_id &&
        request.resource.data.status == resource.data.status &&
        !('verified_at' in request.resource.data)
      );

      allow delete: if isAdmin();
    }
  }
}
