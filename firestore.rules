rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── RBAC Helper Functions ──────────────────────────────────────────────────
    
    // Fetch user's role from their profile document
    function getRole() {
      return request.auth != null && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role
        : 'customer';
    }

    // Support legacy is_admin flag for backward compatibility
    function isAdminLegacy() {
      return request.auth != null && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }

    // Role hierarchies
    function isSuperAdmin() {
      return getRole() == 'super_admin';
    }

    function isAdmin() {
      return isSuperAdmin() || getRole() == 'admin' || isAdminLegacy();
    }

    // Managers can manage catalog (products, coupons, categories) but not delete or edit credentials/settings
    function isManager() {
      return isAdmin() || getRole() == 'manager';
    }

    // Staff can view order/catalog and only update order statuses
    function isStaff() {
      return isManager() || getRole() == 'staff';
    }

    // ─── Products ──────────────────────────────────────────────────────────────
    // Public read. Managers can create/update. Only Admins can delete.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    // ─── Profiles ──────────────────────────────────────────────────────────────
    // Users can read/write their own profile. Staff can view customer profiles.
    // Super Admins can update roles. Users CANNOT change their own roles.
    match /profiles/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isStaff());

      // Allow users to create their own profile, ensuring is_admin & role are safe
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        (!('is_admin' in request.resource.data) || request.resource.data.is_admin == false) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer');

      // Allow users to update their profile details but block self-role modifications
      allow update: if (request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.is_admin == resource.data.is_admin &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) || isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    // ─── Cart Items ────────────────────────────────────────────────────────────
    match /cart_items/{itemId} {
      allow read, delete, update: if request.auth != null &&
        request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.user_id;
    }

    // ─── Orders ───────────────────────────────────────────────────────────────
    // Staff/Admins can read all. Clients can read own.
    // Client creation is blocked (must go via server APIs).
    // Staff can update order status but not total amounts.
    match /orders/{orderId} {
      allow read: if isStaff() ||
        (request.auth != null && request.auth.uid == resource.data.user_id);

      allow create: if false;

      // Staff can update order status; users can cancel confirmed orders
      allow update: if isAdmin() ||
        (isStaff() &&
         request.resource.data.user_id == resource.data.user_id &&
         request.resource.data.total_amount == resource.data.total_amount) ||
        (request.auth != null &&
         request.auth.uid == resource.data.user_id &&
         request.resource.data.status == 'cancelled' &&
         resource.data.status == 'confirmed');

      allow delete: if isSuperAdmin();
    }

    // ─── Order Items ──────────────────────────────────────────────────────────
    match /order_items/{itemId} {
      allow read: if isStaff() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data.user_id
           == request.auth.uid);

      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ─── Coupons ──────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isManager();
      allow delete: if isAdmin();
    }

    // ─── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.user_id &&
        request.resource.data.status == 'pending' &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if isManager();
    }

    // ─── Offers & Carousel & Brands & Categories ──────────────────────────────
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isManager();
      allow delete: if isAdmin();
    }
    match /carousel/{itemId} {
      allow read: if true;
      allow write: if isManager();
      allow delete: if isAdmin();
    }
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isManager();
      allow delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isManager();
      allow delete: if isAdmin();
    }

    // ─── Lens System (Categories, Lenses, Addons) ─────────────────────────────
    match /lens_categories/{catId} {
      allow read: if true;
      allow write: if isManager();
      allow delete: if isAdmin();
    }
    match /lenses/{lensId} {
      allow read: if true;
      allow write: if isManager();
      allow delete: if isAdmin();
    }
    match /lens_addons/{addonId} {
      allow read: if true;
      allow write: if isManager();
      allow delete: if isAdmin();
    }

    // ─── Settings ─────────────────────────────────────────────────────────────
    // Global: readable by public storefront, editable by Admin/SuperAdmin.
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private integration secrets (Telegram tokens, Fast2SMS keys): editable & readable by Super Admin ONLY.
    match /settings/private {
      allow read, write: if isSuperAdmin();
    }

    // ─── Prescriptions ────────────────────────────────────────────────────────
    match /prescriptions/{prescriptionId} {
      allow read: if isStaff() || (request.auth != null && (request.auth.uid == resource.data.user_id || request.auth.uid == resource.data.guestId));
      
      allow create: if request.auth != null
        && (
          (request.resource.data.guestId == request.auth.uid && request.resource.data.guestId.matches('guest-.*'))
          ||
          (request.resource.data.user_id == request.auth.uid && !request.resource.data.user_id.matches('guest-.*'))
        )
        && !('verified' in request.resource.data)
        && !('verified_at' in request.resource.data)
        && !('orderId' in request.resource.data)
        && !('order_id' in request.resource.data);

      allow update: if isStaff() || (
        request.auth != null &&
        (request.auth.uid == resource.data.user_id || request.auth.uid == resource.data.guestId) &&
        request.resource.data.order_id == resource.data.order_id &&
        request.resource.data.status == resource.data.status &&
        !('verified_at' in request.resource.data)
      );

      allow delete: if isAdmin();
    }

    // ─── Admin Logs (Audit Logs) ──────────────────────────────────────────────
    // Write-only collection for integrity. Anyone authenticated can write, but nobody can update or delete.
    // Only Staff/Admins can read logs.
    match /admin_logs/{logId} {
      allow create: if true; // Allow logging logins and failures
      allow read: if isStaff();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
