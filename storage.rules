rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Product Images ───────────────────────────────────────────────────────
    // Product media uploads are handled by Cloudinary. Keep legacy Firebase
    // Storage assets readable, but block direct client writes here.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Prescription Uploads ─────────────────────────────────────────────────
    // Prescription uploads are handled by Cloudinary. If this legacy path is
    // used, only image files under 8MB are accepted for the owner.
    match /prescriptions/{userId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // ─── Carousel & Marketing Images ──────────────────────────────────────────
    match /carousel/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /offers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Block all other paths ────────────────────────────────────────────────
    // Any path not matched above is denied by default in Firebase Storage rules.
  }
}
